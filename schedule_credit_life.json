  },
  {
    "id": "gross_premium",
    "size": "20",
    "class": "money",
    "label": "Premium",
    "width": "100px",
    "formula": "{{premium_rate}}/100*{{sum_insured}}"
  },
  {
    "id": "commission",
    "size": "20",
    "class": "money",
    "label": "Commission",
    "width": "100px",
    "formula": "0.1*{{gross_premium}}"
  },
  {
    "id": "vat_amount",
    "size": "20",
    "class": "money",
    "label": "VAT",
    "width": "100px",
    "formula": "0.075*{{commission}}"
  },
  {
    "id": "net_amount",
    "size": "20",
    "class": "money",
    "label": "NETPremium",
    "width": "100px",
    "formula": "{{gross_premium}}-{{commission}}-{{vat_amount}}"
  },
